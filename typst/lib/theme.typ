// Theme constants for Banks of the Boneyard

#let page-width = 8.5in
#let page-height = 11in
#let margin-x = 0.5in
#let margin-y = 0.5in

#let content-width = page-width - 2 * margin-x
#let content-height = page-height - 2 * margin-y

// Fonts
#let heading-font = "Georgia"
#let body-font = "Georgia"
#let mono-font = "Courier New"

// Font sizes
#let title-size = 36pt
#let headline-size = 28pt
#let subtitle-size = 8pt
#let section-heading-size = 16pt
#let article-title-size = 14pt
#let body-size = 9pt
#let small-size = 7pt
#let tiny-size = 6pt

// Colors
#let accent-color = rgb("#1a1a1a")
#let link-color = rgb("#0645AD")
#let rule-color = rgb("#333333")
#let bg-light = rgb("#f5f5f5")
